# StudyMate AI - Environment Configuration
# Any of the following keys can be provided.
# If none are provided, the app runs gracefully in Mock Mode with zero setup friction!

# Google Gemini (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq (Free fast inference tier at https://console.groq.com/)
GROQ_API_KEY=

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=

# Local Ollama model (Default: llama3.2, ensure ollama serve is running)
OLLAMA_MODEL=llama3.2

# Server Port (Default: 3001)
PORT=3001
